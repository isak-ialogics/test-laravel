# Exact source allowlist shared by both Dockerfiles. Reopen a directory only
# for traversal, immediately deny its children, then allow named descendants.
*
!artisan
!composer.json
!composer.lock
!package.json
!vite.config.js

!app/
app/*
!app/Http/
app/Http/*
!app/Http/Controllers/
app/Http/Controllers/*
!app/Http/Controllers/Controller.php
!app/Models/
app/Models/*
!app/Models/User.php
!app/Providers/
app/Providers/*
!app/Providers/AppServiceProvider.php

!bootstrap/
bootstrap/*
!bootstrap/app.php
!bootstrap/providers.php
!bootstrap/php-runtime.php

!config/
config/*
!config/app.php
!config/auth.php
!config/cache.php
!config/database.php
!config/filesystems.php
!config/logging.php
!config/mail.php
!config/queue.php
!config/services.php
!config/session.php

!database/
database/*
!database/factories/
database/factories/*
!database/factories/UserFactory.php
!database/migrations/
database/migrations/*
!database/migrations/0001_01_01_000000_create_users_table.php
!database/migrations/0001_01_01_000001_create_cache_table.php
!database/migrations/0001_01_01_000002_create_jobs_table.php
!database/seeders/
database/seeders/*
!database/seeders/DatabaseSeeder.php

!docker/
docker/*
!docker/app.Dockerfile
!docker/web.Dockerfile
!docker/php-entrypoint.sh
!docker/nginx/
docker/nginx/*
!docker/nginx/default.conf

!public/
public/*
!public/.htaccess
!public/favicon.ico
!public/index.php
!public/robots.txt

!resources/
resources/*
!resources/css/
resources/css/*
!resources/css/app.css
!resources/js/
resources/js/*
!resources/js/app.js
!resources/js/bootstrap.js
!resources/views/
resources/views/*
!resources/views/welcome.blade.php

!routes/
routes/*
!routes/console.php
!routes/web.php
